# VITE_API_BASE_URL is environment-specific and must never be committed.
# Real values live in the gitignored .env.development.local (dev) and
# .env.production.local (production) files — supply locally/at deploy time.
VITE_API_BASE_URL=

# DOCS_BASIC_AUTH is "user:password" for the API server's /docs Basic Auth gate.
# Used only by `npm run api:sync` to pull openapi.json; not bundled into the app.
DOCS_BASIC_AUTH=
