{
  "name": "orderrun-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "harness:usage": "node scripts/harness-usage/report.mjs",
    "harness:monitor": "node scripts/harness-usage/monitor.mjs",
    "harness:usage:snapshot": "node scripts/harness-usage/snapshot.mjs",
    "harness:usage:collect": "node scripts/harness-usage/collect.mjs",
    "harness:usage:start": "node scripts/harness-usage/run-boundary.mjs start",
    "harness:usage:end": "node scripts/harness-usage/run-boundary.mjs end",
    "harness:usage:test": "node --test 'scripts/harness-usage/**/*.test.mjs'",
    "api:sync": "curl -fsS \"$(sed -n 's#^VITE_API_BASE_URL=##p' .env.development.local | sed 's#/*$##')/openapi.json\" -o docs/api-spec/openapi.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0"
  }
}
